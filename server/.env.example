NODE_ENV=development
PORT=5000
SQLITE_PATH=./data/college.db
JWT_SECRET=replace-with-at-least-32-random-characters
CLIENT_ORIGINS=http://localhost:5173
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
UPLOAD_DIR=uploads
